{
  "functions": {
    "api/send-quiz-email.js": { "maxDuration": 10 },
    "api/send-quiz-sms.js":   { "maxDuration": 10 },
    "api/admin-stats.js":     { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "whatshouldigetatthedispensary.com" }],
      "destination": "https://whatshouldigetatthedispensary.com/quiz",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.whatshouldigetatthedispensary.com" }],
      "destination": "https://www.whatshouldigetatthedispensary.com/quiz",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/cannascope-dashboard", "destination": "/cannascope-dashboard.html" },
    { "source": "/dashboard",            "destination": "/cannascope-dashboard.html" },
    { "source": "/quiz",                 "destination": "/cannascope-quiz.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "whatshouldigetatthedispensary.com" }],     "destination": "/cannascope-quiz.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.whatshouldigetatthedispensary.com" }], "destination": "/cannascope-quiz.html" }
  ]
}
